{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PERSISTENCE_DRIVER",
    "PORT",
    "CORS_ORIGIN",
    "HARNESS_MODE",
    "HARNESS_RUN_EVAL",
    "HARNESS_LOOP_INTERVAL_MS",
    "HARNESS_AUTO_EXECUTE_TURN",
    "HARNESS_ROLES",
    "HARNESS_ROLE_API",
    "HARNESS_ROLE_DISPATCHER",
    "HARNESS_ROLE_SCHEDULER",
    "HARNESS_ROLE_WORKER",
    "HARNESS_ROLE_OBSERVABILITY",
    "HARNESS_ROLE_GOVERNANCE",
    "FEATURE_ENABLE_DAG",
    "FEATURE_ENABLE_SPAWN_CHILD",
    "FEATURE_ENABLE_MEMORY",
    "FEATURE_ENABLE_SANDBOX_EXEC",
    "FEATURE_ENABLE_REAL_WRITE_HIGH",
    "KNOWLEDGE_BASE_URL",
    "KNOWLEDGE_COLLECTION_IDS",
    "KNOWLEDGE_TOP_K",
    "KNOWLEDGE_TIMEOUT_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
