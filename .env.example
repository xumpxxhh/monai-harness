# Copy to `.env` at repo root (optional). Harness also reads process env.
# Start fixed PG: pnpm db:up

# Persistence: memory | postgres
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgres://monai:monai@127.0.0.1:54329/monai_harness

# HTTP (P8c); reserved now
PORT=3000

# demo = CreateRun→execute_turn then exit; serve = keep delivery loops
HARNESS_MODE=demo
HARNESS_RUN_EVAL=true
HARNESS_LOOP_INTERVAL_MS=500

# EDR-014 feature flags (MVP defaults: all false)
FEATURE_ENABLE_DAG=false
FEATURE_ENABLE_SPAWN_CHILD=false
FEATURE_ENABLE_MEMORY=false
FEATURE_ENABLE_SANDBOX_EXEC=false
FEATURE_ENABLE_REAL_WRITE_HIGH=false
