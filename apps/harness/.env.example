# Copy to `apps/harness/.env` (loaded by dotenv on start).
# Postgres: from repo root run `pnpm db:up`

# Persistence: memory | postgres
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgres://monai:monai@127.0.0.1:54329/monai_harness

# Model: stub | openai (M1 slice)
MODEL_DRIVER=stub
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Or a compatible gateway, e.g. Dots:
# OPENAI_BASE_URL=https://api.dots.ai/v1
# OPENAI_BASE_URL=https://api.dots.ai/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_AUTH_HEADER=api-key
# Use none when the gateway rejects response_format:
# OPENAI_RESPONSE_FORMAT=none

# HTTP + web console CORS
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Agent workspace on disk (virtual `/` maps here; default: apps/harness/workspace)
# HARNESS_WORKSPACE_DIR=./workspace

# demo = CreateRun→execute_turn then exit; serve = HTTP + delivery loops
HARNESS_MODE=serve
HARNESS_RUN_EVAL=false
HARNESS_LOOP_INTERVAL_MS=500
HARNESS_AUTO_EXECUTE_TURN=true

# In-process roles (P9d). Unset = all on.
# Allowlist: HARNESS_ROLES=api,dispatcher,scheduler,worker
# Or disable one: HARNESS_ROLE_API=false
# HARNESS_ROLES=
# HARNESS_ROLE_API=true
# HARNESS_ROLE_DISPATCHER=true
# HARNESS_ROLE_SCHEDULER=true
# HARNESS_ROLE_WORKER=true
# HARNESS_ROLE_OBSERVABILITY=true
# HARNESS_ROLE_GOVERNANCE=true

# EDR-014 feature flags (MVP defaults: all false)
FEATURE_ENABLE_DAG=false
FEATURE_ENABLE_SPAWN_CHILD=false
FEATURE_ENABLE_MEMORY=false
FEATURE_ENABLE_SANDBOX_EXEC=false
FEATURE_ENABLE_REAL_WRITE_HIGH=false

# RAG knowledge.search (optional — EDR-016). Empty = tool not in allowlist.
# KNOWLEDGE_BASE_URL=http://localhost:3001
# KNOWLEDGE_COLLECTION_IDS=kb-1e80b748-a66e-4aea-a438-4098a551aa10
# KNOWLEDGE_TOP_K=8
# KNOWLEDGE_TIMEOUT_MS=60000

# Context projection / compression budgets (defaults match contracts MVP).
# CONTEXT_RECENT_TURN_COUNT=6
# CONTEXT_RECENT_TOKEN_BUDGET=4096
# CONTEXT_COMPRESS_THRESHOLD=8192
# CONTEXT_MAX_TOTAL_TOKENS=8192
# CONTEXT_MAX_TOOL_CONTENT_CHARS=8000
